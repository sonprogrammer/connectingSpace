{
  "name": "connecting-space",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "vite dev --port 3001",
    "dev:api": "pnpm --filter @connecting-space/api dev",
    "build": "pnpm run typecheck:web && vite build && next typegen",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typegen:cloudflare": "cf workers types",
    "typegen:next": "next typegen",
    "verify:migration": "cf d1 migrations apply 49000000-0000-4000-8000-000000000049 --local --dir db/migrations",
    "typecheck:web": "pnpm run typegen:cloudflare && pnpm run typegen:next && tsc --noEmit",
    "typecheck": "pnpm run typecheck:web && pnpm --filter @connecting-space/api typecheck && pnpm --filter @connecting-space/shared typecheck",
    "lint:web": "eslint src eslint.config.mjs next.config.ts vite.config.ts cloudflare.config.ts vitest.web.config.mts vitest.worker.config.mts tailwind.config.ts postcss.config.mjs",
    "lint": "pnpm run lint:web && pnpm --filter @connecting-space/api lint && pnpm --filter @connecting-space/shared lint",
    "test:web": "vitest run --config vitest.web.config.mts",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "test": "pnpm run test:web && pnpm run test:worker && pnpm --filter @connecting-space/api test && pnpm --filter @connecting-space/shared test",
    "test:watch": "vitest --config vitest.web.config.mts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@connecting-space/shared": "workspace:*",
    "@tanstack/react-query": "latest",
    "@vinext/cloudflare": "1.4.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "latest",
    "tw-animate-css": "latest",
    "vinext": "1.4.6",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.4",
    "@cloudflare/vitest-plugin": "1.9.2",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-rc.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "husky": "latest",
    "jsdom": "latest",
    "lint-staged": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.1.0"
  }
}
