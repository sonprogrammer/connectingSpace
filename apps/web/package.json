{
  "name": "@connecting-space/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "dev:next": "next dev",
    "build": "next build --webpack",
    "build:next": "next build --webpack",
    "build:worker": "pnpm run typecheck && vite build && next typegen",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typegen:cloudflare": "cf workers types",
    "typegen:next": "next typegen",
    "typecheck": "pnpm run typegen:cloudflare && pnpm run typegen:next && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@connecting-space/shared": "workspace:*",
    "@tanstack/react-query": "latest",
    "@vinext/cloudflare": "1.4.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "latest",
    "tw-animate-css": "latest",
    "vinext": "1.4.6",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.4",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-rc.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.1.0"
  }
}
